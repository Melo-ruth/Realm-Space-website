# Public site URL, used for canonical links, Open Graph and the sitemap
NEXT_PUBLIC_SITE_URL=https://www.realmspace.example

# WhatsApp number in international format (digits, optional +)
NEXT_PUBLIC_WHATSAPP_NUMBER=+256700000000

# Email delivery for /api/inquiry (https://resend.com). Leave empty in development:
# submissions are then logged to the terminal instead of emailed.
RESEND_API_KEY=
# Where enquiries are sent. Comma-separate several addresses.
INQUIRY_TO_EMAIL=
# Optional: a sender on a domain verified in Resend, e.g. "Realm Space <web@realmspace.co.ug>"
INQUIRY_FROM_EMAIL=
